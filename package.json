{
  "name": "myhomewatersystem",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "db:migrate:local": "wrangler d1 migrations apply mhws-staging --local --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "bash scripts/staging-demo.sh",
    "preflight": "node --experimental-strip-types --no-warnings scripts/preflight.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251008.0",
    "@types/node": "22.18.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.42.0"
  }
}
